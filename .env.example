# Copy to .env before first run:  cp .env.example .env
# NEVER commit a real .env, and NEVER paste a real API key in chat or in
# this repo. Provider keys go in the dashboards (Keys / Providers pages),
# NOT in this file. The dashboards give you one unified key each — that
# unified key is what your apps use.

# OmniRoute heap (MB). 8192 = one coding agent (upstream Docker guide).
# Light chat only: set 1024. Two long coding sessions: 10240-12288.
OMNIROUTE_MEMORY_MB=8192
